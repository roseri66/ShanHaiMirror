<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.shanhai</groupId>
    <artifactId>director-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>DirectorService</name>
    <description>山海镜决策网关 —— 把 LLM 调用从客户端搬到服务端（DECISIONS D-23）</description>

    <properties>
        <java.version>17</java.version>

        <!-- ★ 必须显式钉 UTF-8。
             本机 Maven 自报 platform encoding: GBK（zh_CN + Windows），
             不钉的话源码里的中文注释、以及将来 prompt.yaml 里的中文
             会在编译期按 GBK 解读而乱码。

             这与踩坑 #19 是同一类问题的另一面：那次是 UE 的
             SaveStringToFile 默认写 UTF-16，导出的 JSON 外部工具读不了；
             这次是构建工具按系统区域设置解读源文件。
             判据一样——**凡是跨工具/跨语言流动的文本，编码必须显式指定，
             不能依赖平台默认值**。 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- WebClient 在 webflux 里。加它不等于把服务改成响应式——
             web(Tomcat) 仍是服务端模型，webflux 这里只作为 HTTP 客户端用。
             选 WebClient 而非 RestTemplate 的理由：上游是 4–5 秒的慢调用，
             线程不该阻塞在等待上（RestTemplate 已进入维护模式）。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- 熔断（M2）。
             为什么用库而不像客户端那样手写：SHMLlmProvider.cpp 里那个
             `if (Code == 401) bAuthFailed = true` 就是熔断器的手写最简版——
             一个布尔位、永不半开、进程级作用域。在那个位置它是对的：
             单机单进程、失败原因唯一（key 错），一个 bool 完全够。
             服务端不一样：多客户端并发、失败原因多样（超时/限流/5xx）、
             需要半开探测、需要滑动窗口而不是"一次就停"、还要把状态暴露成指标。
             这些是专用件的复杂度，自己写第三遍就会写出一个更差的 Resilience4j。
             判据始终是「专用件的复杂度 vs 需求的复杂度」。 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot3</artifactId>
            <version>2.2.0</version>
        </dependency>
        <!-- CircuitBreakerOperator（把熔断器接进 Mono 链）在这个模块里，
             spring-boot3 starter 不传递依赖它 -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-reactor</artifactId>
            <version>2.2.0</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- 限流（M2）。
             同一个库在 MetaPool 里是**被治理的对象**（控制面纳管它），
             在这里是**治理工具本身**（拿它限流保护上游 LLM 配额）。 -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j_jdk17-core</artifactId>
            <version>8.14.0</version>
        </dependency>

        <!-- 可观测（M4）。
             只暴露 /actuator/prometheus 端点，**不搭 Grafana 面板**——
             按 DECISIONS D-23 修正¹：本机没有 Docker，而设计文档第十二节
             早就预设了这个应对（「面板是给面试官看的证据，不必 7×24 在线」）。
             指标数据是真的、可 curl 可查，只是没有图。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- M0 只要能起、能返回固定 Intent。
             WebClient / Resilience4j / Bucket4j / Redis / MySQL / Micrometer
             都留到各自的里程碑再加 —— 一次性把依赖堆齐，
             等于让 pom 描述一个还不存在的系统。 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 与 sourceEncoding 呼应，双保险 -->
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <arg>-Xlint:all</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
